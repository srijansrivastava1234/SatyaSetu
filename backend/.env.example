# ==============================================================================
# SatyaSetu Server Configuration
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# LLM Synthesis & Extraction (Google Gemini)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Fact-Checking ClaimReview Search (Google Fact Check Tools API)
# Obtain from: https://console.cloud.google.com/apis/library/factchecktools.googleapis.com
GOOGLE_FACTCHECK_API_KEY=

# Authoritative Web Search Engine (Tavily AI Search)
# Optional: Live Google News RSS fallback activates automatically when empty.
# Obtain from: https://app.tavily.com
TAVILY_API_KEY=
